NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dealership
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/dealership_test
# >= 32 random bytes in production, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=12
LOW_STOCK_THRESHOLD=3
FORECAST_WINDOW_DAYS=30
FORECAST_AT_RISK_DAYS=7
MAX_WATCHES_PER_USER=50
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
CORS_ORIGIN=http://localhost:5173
